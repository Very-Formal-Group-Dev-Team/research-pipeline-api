NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_HOST_PORT=3307
DB_NAME=student_research
DB_USER=appuser
DB_PASSWORD=password
DB_ROOT_PASSWORD=rootpassword

JWT_SECRET=your-jwt-secret-change-in-production

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Comma-separated allowed browser origins for CORS in all environments.
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Set for reverse proxy deployments (Railway/NGINX). Accepts true, false, or hop count.
TRUST_PROXY=true

# Optional persistent upload base path (recommended on Railway with volume mount).
# Local development fallback is ./uploads when this is empty.
UPLOAD_PATH=

# URL of keyword_model service used by Find Related Studies.
# Default for this compose stack:
# KEYWORD_MODEL_URL=http://keyword-model:8000
KEYWORD_MODEL_URL=http://keyword-model:8000

# Jitsi Meet base URL (no trailing slash). Local Docker default: https://localhost:8443
JITSI_BASE_URL=https://localhost:8443

# Jitsi stack: run `pnpm docker:jitsi:setup` then `pnpm docker:up` (see docker/jitsi/README.md)
