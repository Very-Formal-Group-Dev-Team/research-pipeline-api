################################################################################
# Jitsi Meet — local dev (used by docker/jitsi/docker-compose.yml)
# Copy to .env or run: pnpm docker:jitsi:setup
################################################################################

# Relative to docker/jitsi/ (where the Jitsi compose file lives)
CONFIG=./cfg
TZ=UTC

HTTP_PORT=8000
HTTPS_PORT=8443
JVB_PORT=10000

# Must include scheme. Do NOT use http://localhost:8000 — Jitsi breaks WebSocket URLs.
# Use HTTPS on 8443 (self-signed cert is generated automatically).
PUBLIC_URL=https://localhost:8443
JITSI_IMAGE_VERSION=stable

DISABLE_HTTPS=0
# Redirect on :8000 uses https://$host without :8443 and breaks room links — keep off.
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0

ENABLE_AUTH=0
ENABLE_GUESTS=1
ENABLE_XMPP_WEBSOCKET=1
ENABLE_COLIBRI_WEBSOCKET=1

# Same machine / Docker Desktop: helps media connect
JVB_ADVERTISE_IPS=127.0.0.1

# Uncomment for LAN access from other devices (use your host LAN IP):
# JVB_ADVERTISE_IPS=192.168.1.100
# PUBLIC_URL=https://192.168.1.100:8443

# Required — run pnpm docker:jitsi:setup to generate
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
